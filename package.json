{
  "name": "dropvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "node --test scripts/release/validate-tag.test.mjs",
    "test:e2e": "playwright test",
    "test:ssr": "playwright test tests/e2e/ssr.spec.ts --project=desktop",
    "skills:verify": "node scripts/verify-skills.mjs",
    "check": "npm run skills:verify && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:release && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@tanstack/react-query": "5.105.0",
    "date-fns": "4.4.0",
    "framer-motion": "14.7.1",
    "i18next": "26.5.11",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
